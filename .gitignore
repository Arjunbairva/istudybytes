# ==============================
# iStudyBytes Git Ignore
# ==============================

# Operating system files
.DS_Store
Thumbs.db

# VS Code
.vscode/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment / secrets
.env
.env.*
!.env.example

# Local configuration / secret files
secrets/
*.secret
*.key

# Supabase local files
.supabase/

# Build/output folders
dist/
build/
out/

# Temporary files
*.tmp
*.temp
*.log

# Backup files
*.bak
*.backup
*~

# OS/editor temporary files
*.swp
*.swo